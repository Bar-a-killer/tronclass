# ==========================================
# 依賴模組 (Dependencies)
# ==========================================
node_modules/
client/node_modules/
jspm_packages/
web_modules/
bower_components/

# ==========================================
# 建置與打包產物 (Build & Packaging Outputs)
# ==========================================
dist/
client/dist/
build/
# pkg 打包產生的大型獨立執行檔 (避免將 40MB+ 二進制檔誤入 Git)
*.exe
tronclass-api
tronclass-api-*

# ==========================================
# 敏感設定與私密檔案 (Secrets & Local Configs)
# ==========================================
# 包含帳號、密碼與個人 Webhook 之設定檔 (保留 sample 範本)
config.yaml
**/config.yaml
*.local.yaml
# 多人版的帳號、點名設定、登入金鑰與每位使用者的執行資料
maincode/data/
*.local.json
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ==========================================
# 日誌與執行階段資料 (Logs & Runtime Data)
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# PM2 與 Process 資料
.pm2/
pids/
*.pid
*.sock
*.seed
*.pid.lock
.lock-wscript

# ==========================================
# 快取與測試覆蓋率 (Caches & Testing)
# ==========================================
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/
client/.vite/
coverage/
.nyc_output/
lib-cov/
.grunt/

# ==========================================
# 編輯器與作業系統檔案 (IDE & OS Files)
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.orig
.DS_Store
Thumbs.db
desktop.ini

