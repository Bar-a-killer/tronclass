{
  "name": "tronclass-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "watch": "tsc --watch --project tsconfig.json",
    "main": "node maincode/main.js ",
    "start": "pm2 start maincode/main.js --name tronclass && pm2 start maincode/scheduler.js --name tronclass-scheduler",
    "delete": "pm2 delete tronclass-scheduler && pm2 delete tronclass",
    "list": "pm2 list",
    "logs": "pm2 logs",
    "stop": "pm2 stop tronclass-scheduler && pm2 stop tronclass",
    "reload": "pm2 reload tronclass-scheduler && pm2 reload tronclass",
    "server": "node maincode/server.js",
    "server:start": "pm2 start maincode/server.js --name tronclass-server",
    "server:stop": "pm2 stop tronclass-server",
    "server:reload": "pm2 reload tronclass-server",
    "build:ui": "cd client && npm run build",
    "ui": "cd client && npm run dev",
    "lan": "concurrently -n server,ui -c blue,green \"npm run server\" \"cd client && npm run dev -- --host\"",
    "build:pkg": "pkg ."
  },
  "bin": {
    "tronclass-api": "maincode/server.js"
  },
  "pkg": {
    "scripts": [
      "maincode/server.js"
    ],
    "targets": [
      "node16-win-x64"
    ],
    "assets": [
      "client/dist/**/*",
      "yamls/**/*",
      "package.json",
      "ocr/**/*"
    ]
  },
  "keywords": [
    "tronclass",
    "api"
  ],
  "author": "rlongdragon",
  "license": "ISC",
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/progress": "^2.0.7",
    "concurrently": "^10.0.5",
    "pkg": "^5.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fetch-cookie": "^3.1.0",
    "jsdom": "^27.0.0",
    "node-fetch": "^3.3.2",
    "onnxruntime-node": "^1.23.0",
    "pm2": "^5.3.0",
    "progress": "^2.0.3",
    "tough-cookie": "^6.0.0",
    "yaml": "2.8.1"
  }
}
